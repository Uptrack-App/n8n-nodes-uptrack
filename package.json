{
    "name": "n8n-nodes-uptrack",
    "version": "0.1.2",
    "description": "n8n node for Uptrack: manage uptime monitors and incidents, and start workflows when a monitor goes down or recovers",
    "license": "MIT",
    "homepage": "https://uptrack.app/integrations/n8n",
    "keywords": [
        "n8n-community-node-package",
        "uptrack",
        "uptime",
        "monitoring",
        "status page",
        "incident"
    ],
    "author": {
        "name": "Uptrack",
        "email": "hello@uptrack.app"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Uptrack-App/n8n-nodes-uptrack.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "n8n-node build && node --test test/*.test.js"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/UptrackApi.credentials.js",
            "dist/credentials/UptrackWebhookApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Uptrack/Uptrack.node.js",
            "dist/nodes/UptrackTrigger/UptrackTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
